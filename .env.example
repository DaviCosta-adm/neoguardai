# Sessão JWT (obrigatório em runtime)
AUTH_SECRET=substitua-por-um-segredo-longo

# PostgreSQL (obrigatório)
# Local:
# DATABASE_URL=postgresql://neoguard:neoguard@127.0.0.1:5432/neoguardai
# Docker Compose / Coolify (serviço db):
DATABASE_URL=postgresql://neoguard:neoguard@db:5432/neoguardai

# URL pública do app (Checkout/Portal/webhooks)
APP_URL=https://neoguardai.rcsolucoes.app.br

# Stripe Billing (assinaturas)
# Use chaves do mesmo modo (live/test) dos price IDs em db/migrations/004_planos_stripe.sql
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Opcional: sobrescrever price IDs do banco
# STRIPE_PRICE_ESSENCIAL=price_...
# STRIPE_PRICE_PROFISSIONAL=price_...
# STRIPE_PRICE_REDE=price_...

# Convites por e-mail (opcional — sem isso o link é só exibido no painel)
# Também usado para alertas de risco alto/crítico à coordenação
# RESEND_API_KEY=
# EMAIL_FROM=NeoGuardAI <onboarding@seudominio.com>

# Cron de snapshots longitudinais (Bearer token em POST /api/cron/risco-snapshots)
# CRON_SECRET=

# OpenAI (Atlas) — opcional
OPENAI_API_KEY=

# Seed automático no boot do container (recomendado na 1ª subida)
SEED_ON_START=true

# Opcional: chave estável se ainda usar Server Actions em múltiplas réplicas
# Gere com: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Docker Compose
POSTGRES_USER=neoguard
POSTGRES_PASSWORD=neoguard
POSTGRES_DB=neoguardai
APP_PORT=3000

# Coolify MCP (coolify-rc) — stdio com escrita/deploy (@masonator/coolify-mcp)
# Token precisa de permissões: read + write + deploy (Coolify → Keys & Tokens → API tokens)
# No Cloud Agent: + → MCP Servers → Add MCP (substitua o HTTP nativo por este stdio)
# Veja também .cursor/mcp.json.example
COOLIFY_RC_URL=https://coolify.rcsolucoes.app.br
COOLIFY_RC_TOKEN=
